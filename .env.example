# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fixitmulticoncepts.com

# Google Analytics 4 measurement ID (loads only after "Accept all")
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console HTML tag verification content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta tag content value (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Email notifications (Resend) for contact + quote forms
# Create a free key at https://resend.com
RESEND_API_KEY=
# Inbox that receives submissions (defaults to info@fixitmulticoncepts.com)
CONTACT_TO_EMAIL=info@fixitmulticoncepts.com
# After verifying your domain in Resend, use e.g. FixIt <noreply@fixitmulticoncepts.com>
# Until then, Resend allows: FixIt Website <onboarding@resend.dev>
CONTACT_FROM_EMAIL=FixIt Website <onboarding@resend.dev>
