# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fixitmulticoncepts.com

# Google Analytics 4 measurement ID (loads only after "Accept all")
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console HTML tag verification content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta tag content value (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
# Create a v3 key pair for fixitmulticoncepts.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional score threshold from 0.0 to 1.0 (default 0.5)
# RECAPTCHA_MIN_SCORE=0.5

# Email notifications (Zoho CPaaS / ZeptoMail) for contact + quote forms
# Copy the Rest API key from Agents >> SMTP/API (not the SMTP password)
ZEPTOMAIL_TOKEN=
# Optional bounce address configured in the Mail Agent
ZEPTOMAIL_BOUNCE_ADDRESS=
# Default matches Host shown in SMTP/API settings
# ZEPTOMAIL_API_URL=https://cpaas.zoho.com/v1.1/email
# Inbox that receives submissions (defaults to operations@fixitmulticoncepts.com)
CONTACT_TO_EMAIL=operations@fixitmulticoncepts.com
# Must use a sender domain verified in your Mail Agent
CONTACT_FROM_EMAIL=FixIt Website <noreply@fixitmulticoncepts.com>
