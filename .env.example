# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fixitmulticoncepts.com

# Google Analytics 4 measurement ID (loads only after "Accept all")
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console HTML tag verification content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta tag content value (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Email notifications (ZeptoMail) for contact + quote forms
# Create a Send Mail Token in your ZeptoMail Mail Agent
ZEPTOMAIL_TOKEN=
# Optional bounce address configured in the Mail Agent
ZEPTOMAIL_BOUNCE_ADDRESS=
# Optional regional API URL (default: https://api.zeptomail.com/v1.1/email)
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# Inbox that receives submissions (defaults to operations@fixitmulticoncepts.com)
CONTACT_TO_EMAIL=operations@fixitmulticoncepts.com
# Must use a sender domain verified in your ZeptoMail Mail Agent
CONTACT_FROM_EMAIL=FixIt Website <noreply@fixitmulticoncepts.com>
